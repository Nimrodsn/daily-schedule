# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anthropic. Optional: without it every Claude feature falls back locally.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# The single Supabase account this app serves. Create it once in the
# dashboard under Authentication -> Users -> Add user, with "auto confirm"
# ticked. The app signs itself in with these, so there is no login screen.
# Server-side only: the password never reaches the browser.
APP_USER_EMAIL=
APP_USER_PASSWORD=

APP_TIMEZONE=Asia/Jerusalem
